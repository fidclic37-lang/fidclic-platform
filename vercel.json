{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "regions": [
    "cdg1"
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/agent-daily",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/backup-weekly",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/cron/crm-mail",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/daily-triggers",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/scheduled-campaigns",
      "schedule": "*/15 * * * *"
    }
  ]
}
